    <!-- About screen -->
    <string name="about_title">About</string>
    <string name="about_tagline">The Android version of a general-purpose downloader that stays extensible without touching the core.</string>
    <string name="about_tagline2">Parallel downloads for videos, images and direct links, built-in addons,</string>
    <string name="about_tagline3">and local definition files for adding more.</string>
    <string name="about_features">Main features</string>
    <string name="about_feature_parallel">Parallel downloads for multiple URLs (Coroutines)</string>
    <string name="about_feature_addons">Built-in addons: yt-dlp / Iwara / image gallery / direct link</string>
    <string name="about_feature_import">Import addons from local files with dangerous-code scanning</string>
    <string name="about_feature_theme">Dynamic color and light/dark themes</string>
    <string name="about_feature_ytdlp">Wide site support via yt-dlp + ffmpeg</string>
    <string name="about_mobile">Mobile conveniences</string>
    <string name="about_mobile_share">Send URLs from the share menu (Morphe YT / browsers / SNS)</string>
    <string name="about_mobile_clipboard">One-tap import of clipboard URLs</string>
